generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

/// A person using the marketplace. At least one of phone/email is required (DB CHECK constraint).
model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  fullName           String                  @map("full_name")
  phone              String?                 @unique
  email              String?                 @unique
  passwordHash       String                  @map("password_hash")
  role               Role                    @default(CUSTOMER)
  isActive           Boolean                 @default(true) @map("is_active")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  addresses          Address[]
  vendor             Vendor?                 @relation("VendorOwner")
  reviewedVendors    Vendor[]                @relation("VendorReviewer")
  takenDownListings  Listing[]               @relation("ListingTakenDownBy")
  cart               Cart?
  orders             Order[]
  orderStatusChanges SubOrderStatusHistory[]

  @@index([role, isActive])
  @@map("users")
}

/// A refresh-token session. The refresh token is `<id>.<secret>`; only SHA-256(secret) is stored.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  code      String     @unique
  districts District[]
  addresses Address[]
  vendors   Vendor[]

  @@map("regions")
}

model District {
  id        Int       @id @default(autoincrement())
  name      String
  regionId  Int       @map("region_id")
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  addresses Address[]
  vendors   Vendor[]

  @@unique([regionId, name])
  @@map("districts")
}

/// A delivery location. At most one default per user (partial unique index in migration).
model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String   @map("recipient_name")
  contactPhone  String   @map("contact_phone")
  regionId      Int      @map("region_id")
  region        Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  districtId    Int      @map("district_id")
  district      District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  wardStreet    String   @map("ward_street")
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("addresses")
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Constitution II: the fixed species catalogue.
enum Species {
  CATTLE
  GOAT
  SHEEP
  PIG
  CHICKEN
  FISH
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK
}

enum MobileMoneyProvider {
  MPESA
  MIXX_BY_YAS
  AIRTEL_MONEY
  HALOPESA
}

/// A seller's shop; one per user. `species` has ≥ 1 value (CHECK) and a GIN index (migration).
model Vendor {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @unique @map("user_id") @db.Uuid
  user            User                 @relation("VendorOwner", fields: [userId], references: [id], onDelete: Cascade)
  shopName        String               @map("shop_name")
  slug            String               @unique
  description     String               @default("")
  regionId        Int                  @map("region_id")
  region          Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  districtId      Int                  @map("district_id")
  district        District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  businessPhone   String               @map("business_phone")
  species         Species[]
  logoKey         String?              @map("logo_key")
  status          VendorStatus         @default(PENDING)
  rejectionReason String?              @map("rejection_reason")
  submittedAt     DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById    String?              @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?                @relation("VendorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  payoutAccount   VendorPayoutAccount?
  listings        Listing[]
  subOrders       SubOrder[]

  @@index([status])
  @@index([regionId])
  @@map("vendors")
}

/// How a shop is paid. Field/method consistency is enforced by CHECK `payout_method_fields`.
model VendorPayoutAccount {
  id            String               @id @default(uuid()) @db.Uuid
  vendorId      String               @unique @map("vendor_id") @db.Uuid
  vendor        Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  method        PayoutMethod
  provider      MobileMoneyProvider?
  mobileNumber  String?              @map("mobile_number")
  bankName      String?              @map("bank_name")
  accountNumber String?              @map("account_number")
  accountName   String               @map("account_name")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("vendor_payout_accounts")
}

/// Constitution II: the only kinds of product that may be listed.
enum ListingType {
  LIVE_ANIMAL
  MEAT
  MILK
  EGGS
}

/// TRAY = 30 eggs.
enum ListingUnit {
  HEAD
  KG
  PIECE
  LITRE
  TRAY
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  TAKEN_DOWN
}

enum AnimalSex {
  MALE
  FEMALE
  MIXED
}

/// A product offered by a shop. Species/type, unit/type, live-animal fields and numeric ranges are
/// enforced by CHECK constraints in the `listings` migration (and mirrored in listing-rules.ts).
model Listing {
  id              String         @id @default(uuid()) @db.Uuid
  vendorId        String         @map("vendor_id") @db.Uuid
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title           String
  description     String         @default("")
  species         Species
  listingType     ListingType    @map("listing_type")
  unit            ListingUnit
  unitPrice       Int            @map("unit_price")
  stockQuantity   Int            @map("stock_quantity")
  breed           String?
  sex             AnimalSex?
  ageMonths       Int?           @map("age_months")
  weightKg        Decimal?       @map("weight_kg") @db.Decimal(5, 1)
  status          ListingStatus  @default(DRAFT)
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(3)
  archivedAt      DateTime?      @map("archived_at") @db.Timestamptz(3)
  takenDownReason String?        @map("taken_down_reason")
  takenDownById   String?        @map("taken_down_by_id") @db.Uuid
  takenDownBy     User?          @relation("ListingTakenDownBy", fields: [takenDownById], references: [id], onDelete: SetNull)
  takenDownAt     DateTime?      @map("taken_down_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  photos          ListingPhoto[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([status, publishedAt])
  @@index([vendorId, status])
  @@index([species])
  @@index([listingType])
  @@index([unitPrice])
  @@map("listings")
}

/// Up to 5 per listing; position 0 is the cover (CHECK `listing_photos_position`).
model ListingPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key       String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([listingId, position])
  @@map("listing_photos")
}

// ------------------------------------------------------------------ Phase 4: cart & orders

enum SubOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum OrderActorType {
  CUSTOMER
  VENDOR
  ADMIN
  MARKETPLACE
}

/// One per user, created on first use; locked FOR UPDATE by every cart write and checkout.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     CartItem[]

  @@map("carts")
}

/// Ranges enforced by CHECK `cart_items_quantity`; at most 50 per cart (under the cart lock).
model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId     String   @map("listing_id") @db.Uuid
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity      Int
  lastSeenPrice Int      @map("last_seen_price")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([cartId, listingId])
  @@index([listingId])
  @@map("cart_items")
}

/// A cash-on-delivery order; the delivery address is copied. Overall status is derived from sub-orders.
model Order {
  id             String        @id @default(uuid()) @db.Uuid
  seq            Int           @unique @default(autoincrement())
  customerId     String        @map("customer_id") @db.Uuid
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recipientName  String        @map("recipient_name")
  contactPhone   String        @map("contact_phone")
  regionName     String        @map("region_name")
  districtName   String        @map("district_name")
  wardStreet     String        @map("ward_street")
  landmark       String?
  paymentMethod  PaymentMethod @default(CASH_ON_DELIVERY) @map("payment_method")
  total          BigInt
  submissionKey  String        @map("submission_key") @db.Uuid
  submissionHash String        @map("submission_hash")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  subOrders      SubOrder[]

  @@unique([customerId, submissionKey])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// One shop's part of an order. `cashCollectedAt` is set exactly when DELIVERED (CHECK).
model SubOrder {
  id              String                  @id @default(uuid()) @db.Uuid
  orderId         String                  @map("order_id") @db.Uuid
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId        String                  @map("vendor_id") @db.Uuid
  vendor          Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  shopName        String                  @map("shop_name")
  subtotal        BigInt
  status          SubOrderStatus          @default(PENDING)
  cashCollectedAt DateTime?               @map("cash_collected_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  items           OrderItem[]
  history         SubOrderStatusHistory[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("sub_orders")
}

/// A copy of what was bought; `lineTotal = unitPrice × quantity` (CHECK).
model OrderItem {
  id          String      @id @default(uuid()) @db.Uuid
  subOrderId  String      @map("sub_order_id") @db.Uuid
  subOrder    SubOrder    @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  listingId   String      @map("listing_id") @db.Uuid
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  title       String
  species     Species
  listingType ListingType @map("listing_type")
  unit        ListingUnit
  unitPrice   Int         @map("unit_price")
  quantity    Int
  lineTotal   BigInt      @map("line_total")

  @@unique([subOrderId, listingId])
  @@index([listingId])
  @@map("order_items")
}

/// Append-only. `actorId` is null exactly for MARKETPLACE (CHECK `sub_order_history_actor`).
model SubOrderStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  subOrderId String          @map("sub_order_id") @db.Uuid
  subOrder   SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  fromStatus SubOrderStatus? @map("from_status")
  toStatus   SubOrderStatus  @map("to_status")
  actorType  OrderActorType  @map("actor_type")
  actorId    String?         @map("actor_id") @db.Uuid
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason     String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subOrderId, createdAt])
  @@map("sub_order_status_history")
}
