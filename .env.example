# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (docker compose: db on 5434) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/animal_husbandry?schema=public

# --- Auth (use long random strings, e.g. `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-chars-min
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# --- Throttling (register/login attempts per client per minute) ---
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000

# --- Logging ---
LOG_LEVEL=info

# --- Seeded administrator (used by `npm run prisma:seed`) ---
ADMIN_FULL_NAME=Platform Admin
ADMIN_EMAIL=admin@example.co.tz
ADMIN_PHONE=+255700000001
ADMIN_PASSWORD=ChangeMe123
