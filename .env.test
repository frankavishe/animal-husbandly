NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/animal_husbandry_test?schema=public
JWT_ACCESS_SECRET=test-access-secret-test-access-secret-0123456789
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=4
AUTH_THROTTLE_LIMIT=1000
AUTH_THROTTLE_TTL_MS=60000
LOG_LEVEL=silent
ADMIN_FULL_NAME=Test Admin
ADMIN_EMAIL=admin@test.co.tz
ADMIN_PHONE=+255700000001
ADMIN_PASSWORD=AdminPass123

# --- Object storage (S3-compatible; docker compose: minio on 9100, console 9101) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=vendor-logos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9100/vendor-logos
S3_FORCE_PATH_STYLE=true
